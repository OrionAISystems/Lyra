{
  "name": "lyra",
  "private": true,
  "version": "0.3.0",
  "description": "Lightweight local-first Windows dictation for the Orion ecosystem",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",

{
  "name": "lyra",
  "private": true,
  "license": "MIT",
  "version": "0.5.13",
  "description": "Lightweight local-first Windows dictation for the Orion ecosystem",
  "type": "module",
  "scripts": {
    "bench:transcription": "cargo run --release --locked --manifest-path src-tauri/Cargo.toml --features regression-bench --example transcription-bench --",
    "notices:generate": "node scripts/dependency-notices.mjs",
    "notices:check": "node scripts/dependency-notices.mjs --check",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:themes-fixture": "node scripts/themes-fixture.mjs",
    "test:updater-fixture": "node scripts/updater-fixture.mjs",
    "test:watch": "vitest",
    "verify:changelog": "node scripts/changelog.mjs verify",
    "verify:version": "node scripts/verify-version.mjs",
    "verify:release-config": "node scripts/verify-release-config.mjs",
    "verify:public-release": "node scripts/verify-public-release.mjs",
    "verify:public-themes": "node scripts/verify-public-release.mjs --themes-only",
    "verify:themes": "node scripts/themes-release.mjs verify-feed-separation",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.11.0",
    "lucide-react": "0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "27.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}

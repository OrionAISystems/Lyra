# JavaScript dependencies and build output
node_modules/
dist/
.vite/

# Tauri/Rust build output
src-tauri/target/
src-tauri/gen/

# Tauri's icon generator emits mobile/AppX variants; Lyra v1 ships Windows x64 only.
src-tauri/icons/android/
src-tauri/icons/ios/
src-tauri/icons/icon.icns
src-tauri/icons/32x32.png
src-tauri/icons/64x64.png
src-tauri/icons/128x128.png
src-tauri/icons/128x128@2x.png
src-tauri/icons/Square*.png
src-tauri/icons/StoreLogo.png

# Local secrets and environment files
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
certificate/

# Lyra-managed runtime/model/user data. These must never enter Git.
models/
runtime/
recordings/
logs/
app-data/
*.gguf
*.bin
*.onnx
*.safetensors
*.wav
*.pcm
*.dmp
*.partial
*.installing

# Internal benchmark audio metadata and local reports may contain private transcripts.
benchmarks/transcription/audio/
benchmarks/transcription/local/

# Locally staged release output (public release assets are uploaded by CI).
release-artifacts/

# Native SDK archives and extracted binaries
*.zip
*.7z
*.tar.gz
*.dll
*.lib
*.pdb


{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyra",
  "version": "0.4.3",
  "identifier": "com.orionaisystems.lyra",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "settings",
        "title": "Lyra Settings",
        "url": "/",
        "width": 1020,
        "height": 760,
        "minWidth": 760,
        "minHeight": 580,
        "resizable": true,
        "decorations": false,
        "visible": true,
        "center": true
      },
      {
        "label": "bar",
        "title": "Lyra",
        "url": "/",
        "width": 190,
        "height": 42,
        "minWidth": 150,
        "minHeight": 30,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "OrionAISystems",
    "category": "Utility",
    "shortDescription": "Local-first Windows dictation",
    "longDescription": "Quiet, local-first dictation for the Orion ecosystem.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Lyra"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwREQ5Q0M4MENBMUFGMzEKUldReHI2RU15Snpkc08zZDZsUlM5OFExeS9GR1BWT0I1SnRTam1RV1U4R1FiWEdQTjVpU2J2dnoK",
      "endpoints": [
        "https://github.com/OrionAISystems/Lyra-Releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
